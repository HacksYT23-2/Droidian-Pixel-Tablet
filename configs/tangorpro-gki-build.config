# Build-config fragment sourced by Google's Android kernel build for both the
# GKI core and TangorPro device kernel. The device config consumes the Kconfig
# fragment; the GKI config applies the same options after gki_defconfig.

if [ -z "${TANGORPRO_PORT_ROOT:-}" ]; then
  echo "TANGORPRO_PORT_ROOT must point to this porting directory's parent" >&2
  exit 1
fi

GKI_FRAGMENT_DEFCONFIG="${GKI_FRAGMENT_DEFCONFIG:-} ${TANGORPRO_PORT_ROOT}/droidian/tangorpro.fragment"

if [ -n "${POST_DEFCONFIG_CMDS:-}" ]; then
  POST_DEFCONFIG_CMDS="${POST_DEFCONFIG_CMDS};"
fi
POST_DEFCONFIG_CMDS="${POST_DEFCONFIG_CMDS} ${ROOT_DIR}/${KERNEL_DIR}/scripts/config --file \${OUT_DIR}/.config --enable CGROUP_DEVICE --enable CGROUP_PIDS --enable PID_NS --enable USER_NS --disable DEBUG_INFO --disable DEBUG_INFO_BTF"
